#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&trackball_listener {
    scroller {
        layers = <4>;
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none      &none     &none     &none         &none                                                    &none        &none  &none      &none     &none                 &none
&none  &kp Q      &kp W     &kp E     &kp R         &kp T                                                    &kp Y        &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A      &kp S     &kp D     &kp F         &kp G       &none                 &none                  &kp H        &kp J  &kp K      &kp L     &kp SEMI              &none
&none  &kp Z      &kp X     &kp C     &kp V         &kp B       &kp SPACE             &kp RET                &kp N        &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &kp LEFT_WIN  &lt 1 BSPC  &mt RCTRL LANGUAGE_2  &mt RSHIFT LANGUAGE_1  &lt 2 ENTER  &none  &none      &kp RGUI  &mo 4                 &none
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans   &trans          &trans          &trans           &trans            &trans
&trans  &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                  &trans   &trans          &trans          &trans           &trans            &trans
&trans  &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &trans  &trans  &trans   &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans            &trans
&trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &trans  &trans  &kp TAB  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_CONTROL  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans   &trans          &trans          &trans           &trans            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans       &trans         &trans     &trans             &trans                        &trans         &trans           &trans                 &trans             &trans         &trans
&none   &kp PLUS     &kp CARET      &kp TILDE  &kp SINGLE_QUOTE   &kp ASTERISK                  &kp DOLLAR     &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp AT_SIGN    &none
&none   &kp MINUS    &kp HASH       &kp COLON  &kp DOUBLE_QUOTES  &kp EQUAL     &trans  &trans  &kp GRAVE      &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET   &kp SEMICOLON  &none
&none   &kp PERCENT  &kp AMPERSAND  &kp PIPE   &kp EXCLAMATION    &kp SLASH     &trans  &trans  &kp BACKSLASH  &kp UNDERSCORE   &kp LESS_THAN          &kp GREATER_THAN   &kp QUESTION   &none
&trans  &trans       &trans         &trans     &trans             &trans        &trans  &trans  &kp TAB        &kp DEL          &trans                 &trans             &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans            &trans             &trans                &trans      &trans                        &trans            &trans          &trans        &trans         &trans                    &trans
&trans  &kp C_PREVIOUS    &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &trans      &out OUT_USB                  &out OUT_TOG      &kp PAGE_UP     &kp UP_ARROW  &kp PAGE_DOWN  &kp LS(LC(LG(NUMBER_4)))  &trans
&trans  &kp C_NEXT        &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &trans      &out OUT_BLE  &trans  &trans  &kp TAB           &kp LEFT_ARROW  &kp DOWN      &kp RIGHT      &kp C_AC_PASTE            &trans
&trans  &kp C_PLAY_PAUSE  &kp C_MUTE         &trans                &trans      &bt BT_NXT    &trans  &trans  &kp LEFT_COMMAND  &mkp LCLK       &kp LEFT_ALT  &mkp RCLK      &trans                    &trans
&trans  &trans            &trans             &trans                &kp DELETE  &kp TAB       &trans  &trans  &trans            &trans          &trans        &trans         &trans                    &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
            >;
        };
    };
};
