#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&trackball_listener {
    scroller {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 3 10
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
        >;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none    &none      &none      &none           &none      &none                                                          &none         &none   &none       &none        &none        &none
&none    &kp Q      &kp P      &kp R           &kp D      &kp C                                                          &kp B         &kp K   &kp U       &kp Y        &kp X        &none
&none    &kp A      &kp T      &kp N           &kp S      &kp W        &none                     &none                   &kp M         &kp H   &kp E       &kp I        &kp O        &none
&none    &kp DEL    &kp Z      &kp L           &kp G      &kp J        &kp ESCAPE                &kp TAB                 &kp F         &kp V   &kp COMMA   &kp PERIOD   &kp ENTER    &none
&none    &lt 4      &kp LCTRL  &kp LEFT_WIN   &kp LALT   &lt 1 BSPC   &mt RCTRL LANGUAGE_2      &mt RSHIFT LANGUAGE_1   &lt 2 SPACE   &none   &none       &trans       &lt 3        &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none         &none         &none         &none         &none                                     &none     &none           &none           &none            &none             &none  
&none  &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                              &trans    &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &none             &none
&none  &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &none               &none   &kp TAB   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp UP_ARROW      &none
&none  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &trans              &trans  &trans    &trans          &trans          &trans           &trans            &none
&none  &trans        &trans        &trans        &trans        &trans        &trans              &trans  &trans    &trans          &none           &none            &trans            &none
            >;
        };

        layer_2 {
            bindings = <
&none   &none         &none           &none       &none               &none                                     &none           &none             &none                   &none               &none          &none
&none   &kp PLUS      &kp CARET       &kp TILDE   &kp SINGLE_QUOTE    &kp ASTERISK                              &kp DOLLAR      &kp RIGHT_BRACE   &kp RIGHT_PARENTHESIS   &kp RIGHT_BRACKET   &kp AT_SIGN    &none
&none   &kp MINUS     &kp HASH        &kp COLON   &kp DOUBLE_QUOTES   &kp EQUAL       &none           &none     &kp GRAVE       &kp LEFT_BRACE    &kp LEFT_PARENTHESIS    &kp LEFT_BRACKET    &kp SEMICOLON  &none
&none   &kp PERCENT   &kp AMPERSAND   &kp PIPE    &kp EXCLAMATION     &kp SLASH       &trans          &trans    &kp BACKSLASH   &kp UNDERSCORE    &kp LESS_THAN           &kp GREATER_THAN    &kp QUESTION   &none
&trans  &trans         &trans         &trans      &trans              &trans          &trans          &trans    &kp TAB         &none             &none                   &trans              &trans         &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none             &none              &none                 &none         &none                                        &none             &none           &none         &none          &none                     &none
&none  &kp C_PREVIOUS    &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &trans        &out OUT_USB                                 &out OUT_TOG      &kp PAGE_UP     &kp UP_ARROW  &kp PAGE_DOWN  &kp LS(LC(LG(NUMBER_4)))  &none
&none  &kp C_NEXT        &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &trans        &out OUT_BLE   &none                &none    &kp TAB           &kp LEFT_ARROW  &kp DOWN      &kp RIGHT      &kp UP_ARROW              &none
&none  &kp C_PLAY_PAUSE  &kp C_MUTE         &trans                &trans        &bt BT_NXT     &trans               &trans   &kp LEFT_COMMAND  &mkp LCLK       &kp LEFT_ALT  &mkp RCLK      &none                     &none
&none  &trans            &trans             &trans                &kp DELETE    &kp TAB        &trans               &trans   &trans            &none           &none         &trans         &trans                    &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none   &none   &none      &none      &none                   &none   &none          &none         &none       &none   &none
&none  &trans  &trans  &trans     &trans     &trans                  &trans  &bt BT_SEL 0   &bt BT_SEL 4     &trans      &trans  &none
&none  &trans  &trans  &trans     &trans     &trans  &none   &none   &trans  &trans         &trans        &trans      &trans  &none
&none  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans         &trans        &trans      &trans  &none
&none  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &none          &none         &trans      &trans  &none
            >;
        };
    };
};